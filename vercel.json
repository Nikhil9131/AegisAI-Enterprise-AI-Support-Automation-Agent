{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "sample_docs/**,database/**,web-app/**",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/web-app/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/web-app/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "CI_ENV": "production",
    "DB_CONNECTION": "sqlite"
  }
}

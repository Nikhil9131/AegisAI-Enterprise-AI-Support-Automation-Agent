# ==============================================================================
# AEGIS AI — Enterprise AI Support & Business Automation Platform
# Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# Database Configuration
# Supports 'sqlite' for frictionless local development or 'mysql' for production
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aegis_ai
DB_USERNAME=root
DB_PASSWORD=rootpassword

# ------------------------------------------------------------------------------
# LLM Providers (OpenAI, Gemini, Anthropic)
# The system abstracts providers dynamically via LLM_PROVIDER
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Vector Database (Qdrant)
# If QDRANT_URL is set to ":memory:" or local path, Qdrant runs in embedded mode!
# For Docker / Production, use http://localhost:6333 or cloud URL
# ------------------------------------------------------------------------------
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=aegis_enterprise_kb

# ------------------------------------------------------------------------------
# Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=aegis_enterprise_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION_HOURS=24
CODEIGNITER_ENCRYPTION_KEY=aegis_ci3_aes256_encryption_key_2026

# ------------------------------------------------------------------------------
# AWS Cloud Configuration (S3, ECR, IAM, CloudWatch)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=aegis-enterprise-knowledge-vault
AWS_CLOUDWATCH_LOG_GROUP=/aegis/enterprise-ai-service

# ------------------------------------------------------------------------------
# Human-In-The-Loop & Automation Guardrails
# ------------------------------------------------------------------------------
ENABLE_HUMAN_IN_THE_LOOP=true
AI_CONFIDENCE_THRESHOLD=0.85
MAX_SQL_ROW_LIMIT=50
